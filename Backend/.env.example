# ===== EcoCycle Backend — Environment Variables =====
# انسخ الملف ده لـ .env وعدّل القيم:
#   cp .env.example .env

# السيرفر
PORT=4000
NODE_ENV=dev

# قاعدة البيانات
MONGO_URI=mongodb://localhost:27017/ecocycle

# الأسرار — استخدم قيمًا قوية وعشوائية في الإنتاج (مثال: openssl rand -hex 32)
JWT_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret
JWT_RESET_SECRET=replace_with_strong_random_reset_secret

# حساب المدير العام الذي ينشئه الـ seed تلقائيًا
ADMIN_EMAIL=admin@ecocycle.com
ADMIN_PASSWORD=admin123456

# قاعدة بيانات معزولة للاختبارات الآلية (npm test)
TEST_MONGO_URI=mongodb://127.0.0.1:27017/ecocycle_test
